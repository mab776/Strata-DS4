mab776 (2026-10-18, NOT applied): GGML_BATCH_INVARIANT_ROWS=16 - 9..16-row 2D matmuls as <= 8-column blocks + the flash-attention
C-split rule up to 16 query rows. One-shot probe (prompt tail in 16-row passes) gives a stable stream, but the reference
(tail in <= 8-row passes) is itself not run-to-run deterministic, so exactness is unproven. Apply after mab776-batch-invariant.patch.

--- a/ggml/src/ggml-cuda/mab776-binv.cuh
+++ b/ggml/src/ggml-cuda/mab776-binv.cuh
@@ -8,3 +8,12 @@
     static const int c = [] { const char * e = getenv("GGML_BATCH_INVARIANT"); return e ? atoi(e) : 0; }();
     return c;
 }
+
+// mab776 GGML_BATCH_INVARIANT_ROWS=16 (with GGML_BATCH_INVARIANT; default 8): calls of 9..16 rows are invariant too - a
+// 2D matmul runs as column blocks of <= 8 (each on the <= 8-row kernels above), flash attention keeps its C-split rule
+// up to 16 query rows (prompt-lookup verify passes of up to 16 rows)
+static inline int ggml_cuda_batch_invariant_rows() {
+    static const int r = [] { const char * e = getenv("GGML_BATCH_INVARIANT_ROWS"); const int v = e ? atoi(e) : 8; return v >= 16 ? 16 : 8; }();
+    return ggml_cuda_batch_invariant() > 0 ? r : 0;
+}
+
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -1197,7 +1197,7 @@
