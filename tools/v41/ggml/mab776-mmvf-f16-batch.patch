--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -826,6 +826,14 @@
         case GGML_TYPE_F16:
             if (GGML_CUDA_CC_IS_NVIDIA(cc)) {
                 const bool src0_small = (src0_ne[1] <= 512 || src0_ne[2]*src0_ne[3] == 1);
+                // mab776 (GGML_MMVF_F16_MAX=N, opt-in; the Strata-DS4 fork's M11 patch): small F16 weights keep the
+                // vector kernel up to N columns.  DeepSeek V4.1's decode verify passes (2-8 tokens) multiply skinny F16
+                // weights (the 20480 x 24 hyper-connection mixes, the compressors' and the indexer's projections) where
+                // mul_mat_f's tensor-core tiles cost ~1.75x the one-token vector kernel's time per call (V4: measured).
+                static const int f16_max = [] { const char * e = getenv("GGML_MMVF_F16_MAX"); return e ? atoi(e) : 0; }();
+                if (f16_max > 0 && src0_small && ne11 <= std::min(f16_max, MMVF_MAX_BATCH_SIZE)) {
+                    return true;
+                }
                 if (ampere_mma_available(cc)) {
                     return src0_small && ne11 == 1;
                 }
