+++ b/ggml/src/ggml-cuda/mab776-binv.cuh
@@ -0,0 +1,10 @@
+#pragma once
+// mab776 GGML_BATCH_INVARIANT=C (opt-in, unset/0 = off): matmuls and flash attention of up to 8 rows compute each row
+// with the same arithmetic whatever the row count (vector kernels for float weights, the 1-column MMVQ warp count, no
+// 1-row fusions, C key splits per flash-attention output tile), so a batched decode row matches the row run alone.
+#include <cstdlib>
+
+static inline int ggml_cuda_batch_invariant() {
+    static const int c = [] { const char * e = getenv("GGML_BATCH_INVARIANT"); return e ? atoi(e) : 0; }();
+    return c;
+}
