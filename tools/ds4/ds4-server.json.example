{
 "_comment": [
  "mab776 M4: Strata's server (serve/server.py --engine strata --config THIS) in front of the DeepSeek-V4-Flash engine.",
  "The chat template in the tokenizer directory selects serve/deepseek.py (DSML tool calls, stop id 1 = eos, bos from",
  "special_ids); 'architecture' only asserts it. Make the directory with:",
  "  python tools/strata_tokenizer.py --gguf <the UD-IQ2_M blob> --out /data/ds4   (-> /data/ds4/tokenizer)",
  "exe/args belong to M5 (tools/ds4 ds4_serve, Strata's line protocol: READY <ctx> stop; unknown GEN keys skipped);",
  "they go to the engine as they are (nothing is added; its --slots are VRAM expert slots). Starting point = M2's",
  "measured flags (bench/mab776-m2/m2run.sh). A cold load over 900 s needs STRATA_ENGINE_READY_S in the SERVER's",
  "environment (the config's 'env' reaches the engine only). The port is --port on the command line.",
  "Left out on purpose - the server refuses them for DeepSeek: vision, parallel, slot_save_path (no SAVE/RESTORE),",
  "vram_elastic, expert_profile_save. Ignored for DeepSeek: effort_position 'end', tool_call_recovery.",
  "sampling = stack 73's defaults (its /props); allowed_hosts = the network alias it replaces and the container name."
 ],
 "architecture": "deepseek4",
 "exe": "build-ds4-cu13/ds4_serve",
 "cwd": "/src",
 "args": ["-m", "/m/sha256-a79d3b8c742f240dc947758bbeb46d266e9328ace6a3b71704ab4bf2a8610d68",
          "--ctx", "262144", "--comp-type", "iq4_nl", "--icomp-q8", "--slots", "auto", "--vram-margin", "2.0",
          "--pcie", "0.55", "--vram-lru", "--pf-b", "0.7", "--arena-gib", "40", "--arena-skip-resident",
          "--prefill-chunk", "4096", "--chunk-mmq", "--chunk-prestage",
          "--profile", "bench/ds4-2026-10-05/route-probe/ds4routes.bin", "--stop", "1"],
 "tokenizer": "/data/ds4/tokenizer",
 "log": "/data/logs/ds4-engine.log",
 "model_name": "deepseek-v4-flash",
 "host": "0.0.0.0",
 "gpu": 0,
 "sampling": {"temperature": 1.0, "top_p": 1.0, "top_k": 40, "min_p": 0.05},
 "effort_position": "start",
 "reasoning_close_retry": true,
 "reasoning_loop_recovery": false,
 "tool_call_recovery": false,
 "allowed_hosts": ["ds4-lcpp", "strata-ds4"]
}
