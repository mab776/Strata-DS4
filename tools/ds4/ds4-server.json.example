{
 "_comment": [
  "mab776: Strata's server (serve/server.py --engine strata --config THIS) in front of the DeepSeek-V4-Flash engine",
  "(tools/ds4 ds4_serve). The LIVE copy is portainer/deepseek-strata/ds4-server.json (stack 74, deepseek-strata), deployed",
  "with its snapshot.sh; paths below are the container's (/app = the deploy snapshot, /m = the model blob, /mtp = the MTP",
  "head). The chat template in the tokenizer directory selects serve/deepseek.py (DSML tool calls, stop id 1); make it with",
  "  python tools/strata_tokenizer.py --gguf <the UD-IQ2_M blob> --out <dir>   (-> <dir>/tokenizer)",
  "Engine flags (README.mab776.md): --expert-slots auto (never --slots: the server reads that as its parallel count),",
  "--vram-margin 9 / --vram-grow 2 = the elastic GPU 0 cache (prompts on the margin budget, decode on the grown one),",
  "--gpu1 1 = GPU 1 as a static expert tier, --mtp = speculative decoding, --park-mib = conversation parking in RAM;",
  "env STRATA_MMQ_FP4=1 = the 2 MXFP4 layers on FP4 MMQ. gpu [0, 1] + gpu_order as_given keep the dense half on GPU 0.",
  "Left out on purpose - the server refuses them for DeepSeek: vision, parallel, slot_save_path, vram_elastic.",
  "Speculative decoding (10-10): --mtp-device 1 = the MTP head's MXFP4 experts on GPU 1 (--arena-gib 41 = room for the experts GPU 1's tier gives up); --mtp-k K = chained drafts per verify pass: K=2 is the fastest (M7c sweep), K=1 deployed while a greedy-loop trial runs (README.md). A request overrides it with strata_tune.mtp_k (0 = no drafts)."
 ],
 "architecture": "deepseek4",
 "exe": "build/ds4_serve",
 "cwd": "/app",
 "args": [
  "-m",
  "/m/sha256-a79d3b8c742f240dc947758bbeb46d266e9328ace6a3b71704ab4bf2a8610d68",
  "--ctx",
  "262144",
  "--comp-type",
  "iq4_nl",
  "--icomp-q8",
  "--expert-slots",
  "auto",
  "--vram-margin",
  "9.0",
  "--vram-grow",
  "2.0",
  "--gpu1",
  "1",
  "--pcie",
  "0.55",
  "--vram-lru",
  "--pf-b",
  "0.7",
  "--arena-gib",
  "41",
  "--arena-skip-resident",
  "--prefill-chunk",
  "2048",
  "--chunk-mmq",
  "--chunk-prestage",
  "--profile",
  "ds4routes.bin",
  "--stop",
  "1",
  "--mtp",
  "/mtp/DeepSeek-V4-Flash-MTP-bf16.gguf",
  "--mtp-device",
  "1",
  "--mtp-k",
  "1",
  "--park-mib",
  "4096"
 ],
 "tokenizer": "/app/tokenizer",
 "log": "/data/logs/ds4-engine.log",
 "model_name": "deepseek-v4-flash",
 "host": "0.0.0.0",
 "gpu": [
  0,
  1
 ],
 "sampling": {
  "temperature": 1.0,
  "top_p": 1.0,
  "top_k": 40,
  "min_p": 0.05
 },
 "effort_position": "start",
 "reasoning_close_retry": true,
 "reasoning_loop_recovery": false,
 "tool_call_recovery": false,
 "allowed_hosts": [
  "ds4-lcpp",
  "strata-ds4"
 ],
 "env": {
  "STRATA_MMQ_FP4": "1",
  "GGML_NO_BACKTRACE": "1"
 },
 "aliases": [
  "deepseek-v4-flash-strata"
 ],
 "gpu_order": "as_given"
}