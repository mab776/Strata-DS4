+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// mab776 M10: row-wise top-k by radix SELECT (DeepSeek V4's lightning indexer: k = 512 of up to 65,536 compressed rows
+// per query, 2,048 queries per prefill chunk).  The CUB path sorts every whole row and keeps its first k (a segmented
+// radix sort: ~8 passes of key/value scatters, plus a full [ncols, nrows] argsort buffer).  Here one block owns one row:
+// histogram passes over 12 + 10 + 10 bits of an order-preserving key find the k-th largest key T and how many keys
+// equal to T to take (stopping early once every element still undecided is taken), then one pass writes the indices of
+// the keys above T and the first of those equal to it.  The row stays in L2 between passes.  Output order is arbitrary
+// (ggml's TOP_K promises none); ties at T are broken arbitrarily, as CUB's order among equal keys.  GGML_TOPK_RADIX=0:
+// the stock path.
+namespace topk_radix {
+
+static __device__ __forceinline__ uint32_t f2key(float v) {   // larger float -> larger key
+    const uint32_t b = __float_as_uint(v);
+    return (b & 0x80000000u) ? ~b : (b | 0x80000000u);
+}
+
+template <int NT>
+static __device__ __forceinline__ int block_scan_incl(int v, int * ws) {
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+        const int u = __shfl_up_sync(0xffffffffu, v, o);
+        if (lane >= o) v += u;
+    }
+    if (lane == 31) ws[warp] = v;
+    __syncthreads();
+    if (warp == 0) {
+        int w = lane < NT / 32 ? ws[lane] : 0;
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int u = __shfl_up_sync(0xffffffffu, w, o);
+            if (lane >= o) w += u;
+        }
+        ws[lane] = w;
+    }
+    __syncthreads();
+    const int r = v + (warp > 0 ? ws[warp - 1] : 0);
+    __syncthreads();
+    return r;
+}
+
+// grid (nrows), block NT; dst row r = the indices of src row r's k largest values (k <= ncols)
+template <int NT>
+static __global__ void __launch_bounds__(NT) kernel(const float * __restrict__ src, int * __restrict__ dst, int ncols,
+                                                    int k, int64_t src_stride, int64_t dst_stride) {
+    constexpr int NB = 1 << 12;   // the first digit's bins; then 10 + 10 bits
+    __shared__ int hist[NB];
+    __shared__ int ws[32];
+    __shared__ uint32_t s_prefix;
+    __shared__ int s_krem, s_done, s_gt, s_eq;
+    const float * row = src + (int64_t) blockIdx.x * src_stride;
+    int * out = dst + (int64_t) blockIdx.x * dst_stride;
+    const int lane = threadIdx.x & 31;
+
+    uint32_t prefix = 0;   // the threshold key's bits above `shift`, decided so far
+    int krem = k;          // of the elements matching `prefix` above `shift`, how many are still to take
+    int shift = 32;
+#pragma unroll 1
+    for (int pass = 0; pass < 3; ++pass) {
+        const int bits = pass == 0 ? 12 : 10;
+        const int nb = 1 << bits;
+        const int hs = shift;
+        shift -= bits;
+        for (int i = threadIdx.x; i < nb; i += NT) hist[i] = 0;
+        __syncthreads();
+        for (int c = threadIdx.x; c - lane < ncols; c += NT) {   // whole warps iterate (match_any needs them all)
+            int bin = -1;
+            if (c < ncols) {
+                const uint32_t key = f2key(row[c]);
+                if (hs >= 32 || (key >> hs) == (prefix >> hs)) bin = (int) ((key >> shift) & (uint32_t) (nb - 1));
+            }
+            // warp-aggregated: the invisible rows (-inf) and ReLU zeros pile into one bin
+            const unsigned peers = __match_any_sync(0xffffffffu, bin);
+            if (bin >= 0 && lane == __ffs(peers) - 1) atomicAdd(&hist[bin], __popc(peers));
+        }
+        __syncthreads();
+        // the digit: counting bins from the top, the first whose running total reaches krem.  Thread t owns the bins
+        // [nb - (t+1)*per, nb - t*per)
+        const int per = nb / NT > 0 ? nb / NT : 1;
+        const int top = nb - (int) threadIdx.x * per;
+        int part = 0;
+        if ((int) threadIdx.x * per < nb)
+            for (int j = 1; j <= per; ++j) part += hist[top - j];
+        const int incl = block_scan_incl<NT>(part, ws);
+        const int excl = incl - part;
+        if ((int) threadIdx.x * per < nb && excl < krem && incl >= krem) {
+            int run = excl;
+            for (int j = 1; j <= per; ++j) {
+                const int d = top - j, h = hist[d];
+                if (run + h >= krem) {
+                    s_prefix = prefix | ((uint32_t) d << shift);
+                    s_krem = krem - run;
+                    s_done = h == krem - run;   // every element left in this digit is taken
+                    break;
+                }
+                run += h;
+            }
+        }
+        __syncthreads();
+        prefix = s_prefix;
+        krem = s_krem;
+        const int done = s_done;
+        __syncthreads();
+        if (done) break;
+    }
+    if (threadIdx.x == 0) { s_gt = 0; s_eq = 0; }
+    __syncthreads();
+    const int ngt = k - krem;
+    const uint32_t tp = prefix >> shift;
+    for (int c = threadIdx.x; c < ncols; c += NT) {
+        const uint32_t kv = f2key(row[c]) >> shift;
+        if (kv > tp) {
+            out[atomicAdd(&s_gt, 1)] = c;
+        } else if (kv == tp) {
+            const int e = atomicAdd(&s_eq, 1);
+            if (e < krem) out[ngt + e] = c;
+        }
+    }
+}
+
