+// mab776: hc_pre's pre and post gates in one launch (they were 8: mul, add, sigmoid, scale per gate).  One thread per
+// (token, h).  __fmul_rn / __fadd_rn keep the unfused graph's two roundings (nvcc may otherwise contract them into an
+// FMA under -use_fast_math); the sigmoid is the unary op's own expression, compiled with the same flags; the eps add
+// and the x2 match scale_f32's fma(1, x, eps) and fma(2, x, 0) exactly.
+static __global__ void dsv4_hc_gates_f32(
+        const float * mixes,
+        const float * scale,
+        const float * base,
+        float * dst,
+        int64_t n_tokens,
+        int64_t sm0,
+        int64_t sm1,
+        int64_t ss0,
+        int64_t sb0,
+        int64_t sd0,
+        int64_t sd1,
+        float   eps) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_tokens*2*DSV4_HC) {
+        return;
+    }
+    ggml_cuda_pdl_sync();
+    const int64_t h = i % (2*DSV4_HC);
+    const int64_t t = i / (2*DSV4_HC);
+    const float s = h < DSV4_HC ? scale[0] : scale[ss0];
+    const float a = __fadd_rn(__fmul_rn(mixes[h*sm0 + t*sm1], s), base[h*sb0]);
+    const float sg = 1.0f / (1.0f + expf(-a));
+    dst[h*sd0 + t*sd1] = h < DSV4_HC ? __fadd_rn(sg, eps) : __fmul_rn(2.0f, sg);
+}
+
+void ggml_cuda_op_dsv4_hc_gates(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * mixes = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * base  = dst->src[2];
+
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32);
+    GGML_ASSERT(scale->type == GGML_TYPE_F32);
+    GGML_ASSERT(base->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(mixes->ne[0] == (2 + DSV4_HC)*DSV4_HC);
+    GGML_ASSERT(dst->ne[0] == 2*DSV4_HC && dst->ne[1] == mixes->ne[1]);
+
+    const int64_t n_tokens = mixes->ne[1];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t n = n_tokens*2*DSV4_HC;
+    const int block_size = 64;
+    const dim3 block_dims(block_size, 1, 1);
+    const dim3 grid_dims((unsigned) ((n + block_size - 1) / block_size), 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+
+    ggml_cuda_kernel_launch(dsv4_hc_gates_f32, launch_params,
+            (const float *) mixes->data, (const float *) scale->data, (const float *) base->data, (float *) dst->data,
+            n_tokens,
+            (int64_t) (mixes->nb[0] / sizeof(float)), (int64_t) (mixes->nb[1] / sizeof(float)),
+            (int64_t) (scale->nb[0] / sizeof(float)),
+            (int64_t) (base->nb[0] / sizeof(float)),
+            (int64_t) (dst->nb[0] / sizeof(float)), (int64_t) (dst->nb[1] / sizeof(float)),
+            eps);
+}
