+// ggml_compute_forward_dsv4_hc_gates (mab776)
+
+void ggml_compute_forward_dsv4_hc_gates(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * mixes = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * base  = dst->src[2];
+    const int64_t hc = 4;
+    const int64_t n_tokens = mixes->ne[1];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const float s0 = *(const float *) ((const char *) scale->data);
+    const float s1 = *(const float *) ((const char *) scale->data + scale->nb[0]);
+    for (int64_t t = params->ith; t < n_tokens; t += params->nth) {
+        const float * m = (const float *) ((const char *) mixes->data + t*mixes->nb[1]);
+        float * d = (float *) ((char *) dst->data + t*dst->nb[1]);
+        for (int64_t h = 0; h < 2*hc; ++h) {
+            const float b = *(const float *) ((const char *) base->data + h*base->nb[0]);
+            volatile float a = m[h*(mixes->nb[0]/sizeof(float))]*(h < hc ? s0 : s1);   // two roundings, as mul then add
+            const float sg = 1.0f/(1.0f + expf(-(a + b)));
+            d[h] = h < hc ? sg + eps : 2.0f*sg;
+        }
+    }
+}
