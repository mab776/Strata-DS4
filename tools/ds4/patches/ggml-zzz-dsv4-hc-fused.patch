+// ggml_compute_forward_dsv4_hc_mix (mab776 M13): the reference form, one row of fn per task
+
+void ggml_compute_forward_dsv4_hc_mix(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * fn = dst->src[0];
+    const ggml_tensor * x  = dst->src[1];
+    const int64_t k = fn->ne[0], m = fn->ne[1], n_tokens = x->ne[1];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    for (int64_t i = params->ith; i < m; i += params->nth) {
+        const ggml_fp16_t * w = (const ggml_fp16_t *) ((const char *) fn->data + i*fn->nb[1]);
+        for (int64_t t = 0; t < n_tokens; ++t) {
+            const float * xv = (const float *) ((const char *) x->data + t*x->nb[1]);
+            double d = 0.0, q = 0.0;
+            for (int64_t j = 0; j < k; ++j) {
+                d += (double) GGML_CPU_FP16_TO_FP32(w[j]) * xv[j];
+                q += (double) xv[j] * xv[j];
+            }
+            *(float *) ((char *) dst->data + i*dst->nb[0] + t*dst->nb[1]) = (float) d / sqrtf((float) (q / k) + eps);
+        }
+    }
+}
+
+// ggml_compute_forward_dsv4_hc_pre_norm (mab776 M13): hc_pre then rms_norm * norm_w, as the two ops
+
+void ggml_compute_forward_dsv4_hc_pre_norm(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x  = dst->src[0];
+    const ggml_tensor * wt = dst->src[1];
+    const ggml_tensor * nw = dst->src[2];
+    const int64_t n_embd = x->ne[0], hc = x->ne[1], n_tokens = x->ne[2];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    for (int64_t t = params->ith; t < n_tokens; t += params->nth) {
+        float * d = (float *) ((char *) dst->data + t*dst->nb[1]);
+        ggml_float sum2 = 0.0;
+        for (int64_t i = 0; i < n_embd; ++i) {
+            float s = 0.0f;
+            for (int64_t h = 0; h < hc; ++h)
+                s += *(const float *) ((const char *) x->data + i*x->nb[0] + h*x->nb[1] + t*x->nb[2]) *
+                     *(const float *) ((const char *) wt->data + h*wt->nb[0] + t*wt->nb[1]);
+            d[i] = s;
+            sum2 += (ggml_float) (s*s);
+        }
+        const float scale = 1.0f/sqrtf((float) (sum2/n_embd) + eps);
+        for (int64_t i = 0; i < n_embd; ++i)
+            d[i] = d[i]*scale * *(const float *) ((const char *) nw->data + i*nw->nb[0]);
+    }
+}
