+// mab776 M13: hc_pre's mixes in one launch - the flattened streams' RMS norm and the F16 projection were two kernels
+// (rms_norm_f32<1024> on n_tokens blocks: ~5 us at 3 tokens, then the [16384 x 24] matvec), three times a decode layer.
+// One block per output row: every thread reads its half2 weights once and both sums (x.w and x.x) for every token from
+// the same float2 loads; the scale is applied after the dot (so not bit-identical to the two ops).
+template <int nt>
+static __global__ void dsv4_hc_mix_f32(
+        const half  * fn,
+        const float * x,
+        float * dst,
+        int64_t k,
+        int64_t sf1,
+        int64_t sx1,
+        int64_t sd0,
+        int64_t sd1,
+        float   eps) {
+    ggml_cuda_pdl_lc();
+    const int64_t row = blockIdx.x;
+    const half2 * w2 = (const half2 *) (fn + row*sf1);
+    float dot[nt], ss[nt];
+#pragma unroll
+    for (int t = 0; t < nt; ++t) {
+        dot[t] = 0.0f;
+        ss[t]  = 0.0f;
+    }
+    ggml_cuda_pdl_sync();
+    for (int64_t j = threadIdx.x; j < k/2; j += blockDim.x) {
+        const float2 w = __half22float2(w2[j]);
+#pragma unroll
+        for (int t = 0; t < nt; ++t) {
+            const float2 v = ((const float2 *) (x + t*sx1))[j];
+            dot[t] += w.x*v.x + w.y*v.y;
+            ss[t]  += v.x*v.x + v.y*v.y;
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < nt; ++t) {
+        dot[t] = warp_reduce_sum(dot[t]);
+        ss[t]  = warp_reduce_sum(ss[t]);
+    }
+    __shared__ float s_part[32][2*nt];
+    const int warp = threadIdx.x / WARP_SIZE, lane = threadIdx.x % WARP_SIZE, nwarps = blockDim.x / WARP_SIZE;
+    if (lane == 0) {
+#pragma unroll
+        for (int t = 0; t < nt; ++t) {
+            s_part[warp][2*t]     = dot[t];
+            s_part[warp][2*t + 1] = ss[t];
+        }
+    }
+    __syncthreads();
+    if (warp == 0) {
+#pragma unroll
+        for (int t = 0; t < nt; ++t) {
+            float d = lane < nwarps ? s_part[lane][2*t]     : 0.0f;
+            float q = lane < nwarps ? s_part[lane][2*t + 1] : 0.0f;
+            d = warp_reduce_sum(d);
+            q = warp_reduce_sum(q);
+            if (lane == 0) {
+                dst[row*sd0 + t*sd1] = d * rsqrtf(q / (float) k + eps);
+            }
+        }
+    }
+}
+
+void ggml_cuda_op_dsv4_hc_mix(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * fn = dst->src[0];
+    const ggml_tensor * x  = dst->src[1];
+
+    GGML_ASSERT(fn->type == GGML_TYPE_F16);
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(fn->ne[0] % 2 == 0);
+    GGML_ASSERT((fn->nb[1] % 4) == 0 && (x->nb[1] % 8) == 0);
+    GGML_ASSERT(x->ne[1] >= 1 && x->ne[1] <= 8);
+
+    const int64_t k = fn->ne[0];
+    const int64_t m = fn->ne[1];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const dim3 block_dims(1024, 1, 1);
+    const dim3 grid_dims((unsigned) m, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+    const half  * fd = (const half *) fn->data;
+    const float * xd = (const float *) x->data;
+    float * dd = (float *) dst->data;
+    const int64_t sf1 = fn->nb[1] / sizeof(half), sx1 = x->nb[1] / sizeof(float);
+    const int64_t sd0 = dst->nb[0] / sizeof(float), sd1 = dst->nb[1] / sizeof(float);
+    switch (x->ne[1]) {
+#define HC_MIX_CASE(NT) case NT: ggml_cuda_kernel_launch(dsv4_hc_mix_f32<NT>, launch_params, fd, xd, dd, k, sf1, sx1, sd0, sd1, eps); break;
+        HC_MIX_CASE(1) HC_MIX_CASE(2) HC_MIX_CASE(3) HC_MIX_CASE(4)
+        HC_MIX_CASE(5) HC_MIX_CASE(6) HC_MIX_CASE(7) HC_MIX_CASE(8)
+#undef HC_MIX_CASE
+        default: GGML_ABORT("dsv4_hc_mix: n_tokens");
+    }
+}
+
+// mab776 M13: rms_norm(hc_pre(x, weights)) * norm_w in one launch, rounded exactly as the two ops are: the weighted sum
+// is dsv4_hc_pre_f32's expression for every element, kept in registers, and the norm is rms_norm_f32<1024, true>'s
+// loop, block reduction and products (same block size, same order) - one block per token.  The intermediate never
+// goes to memory and one launch (~1.8 us at 3 tokens) is gone.
+static constexpr int DSV4_PN_BLOCK = 1024;
+static constexpr int DSV4_PN_MAXPER = 8;   // n_embd <= 8192
+
+static __global__ void dsv4_hc_pre_norm_f32(
+        const float * x,
+        const float * weights,
+        const float * norm_w,
+        float * dst,
+        int     n_embd,
+        int64_t hc,
+        int64_t sx0,
+        int64_t sx1,
+        int64_t sx2,
+        int64_t sw0,
+        int64_t sw1,
+        int64_t sn0,
+        int64_t sd0,
+        int64_t sd1,
+        float   eps) {
+    ggml_cuda_pdl_lc();
+    const int64_t it  = blockIdx.x;
+    const int     tid = threadIdx.x;
+    float y[DSV4_PN_MAXPER];
+    float tmp = 0.0f;
+    ggml_cuda_pdl_sync();
+    int j = 0;
+    for (int col = tid; col < n_embd; col += DSV4_PN_BLOCK, ++j) {
+        float sum = 0.0f;
+        for (int64_t ih = 0; ih < hc; ++ih) {
+            const float xv = x[col*sx0 + ih*sx1 + it*sx2];
+            const float wv = weights[ih*sw0 + it*sw1];
+            sum += xv * wv;
+        }
+        const float xi = 1.0f * sum;   // dsv4_hc_pre_f32 stores scale * sum (scale 1)
+        y[j] = xi;
+        tmp += xi * xi;
+    }
+    __shared__ float s_sum[32];
+    tmp = block_reduce<block_reduce_method::SUM, DSV4_PN_BLOCK>(tmp, s_sum);
+    const float mean  = tmp / n_embd;
+    const float scale = rsqrtf(mean + eps);
+    j = 0;
+    for (int col = tid; col < n_embd; col += DSV4_PN_BLOCK, ++j) {
+        dst[col*sd0 + it*sd1] = scale * y[j] * norm_w[col*sn0];
+    }
+}
+
+void ggml_cuda_op_dsv4_hc_pre_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x       = dst->src[0];
+    const ggml_tensor * weights = dst->src[1];
+    const ggml_tensor * norm_w  = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && weights->type == GGML_TYPE_F32 && norm_w->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[0] <= (int64_t) DSV4_PN_BLOCK*DSV4_PN_MAXPER);
+
+    const int64_t n_embd   = x->ne[0];
+    const int64_t hc       = x->ne[1];
+    const int64_t n_tokens = x->ne[2];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const dim3 block_dims(DSV4_PN_BLOCK, 1, 1);
+    const dim3 grid_dims((unsigned) n_tokens, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+    ggml_cuda_kernel_launch(dsv4_hc_pre_norm_f32, launch_params,
+            (const float *) x->data, (const float *) weights->data, (const float *) norm_w->data, (float *) dst->data,
+            (int) n_embd, hc,
+            (int64_t) (x->nb[0] / sizeof(float)), (int64_t) (x->nb[1] / sizeof(float)), (int64_t) (x->nb[2] / sizeof(float)),
+            (int64_t) (weights->nb[0] / sizeof(float)), (int64_t) (weights->nb[1] / sizeof(float)),
+            (int64_t) (norm_w->nb[0] / sizeof(float)),
+            (int64_t) (dst->nb[0] / sizeof(float)), (int64_t) (dst->nb[1] / sizeof(float)),
+            eps);
+}
