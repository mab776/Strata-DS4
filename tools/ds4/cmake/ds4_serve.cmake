# tools/ds4/cmake/ds4_serve.cmake - (mab776 M5) ds4_serve: the DS4 engine as a resident server speaking Strata's engine
# line protocol (serve/server.py's StrataEngine).  include()d (OPTIONAL) after ds4_engine.cmake; mirrors ds4_generate's
# targets:
#   CUDA tree (build-ds4-gpu / build-ds4-cu13): ds4_serve      (dense on the CUDA backend, the full expert tier)
#   CPU tree  (build-ds4-cpu)                 : ds4_serve_cpu  (CPU backend + the CPU-only tier; the mini fixtures)
#   both                                      : test_ds4_sampler (the host sampler chain, header-only, no ggml)
set(_ds4_serve_inc ${CMAKE_CURRENT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR}/tools/ds4)
find_package(Threads REQUIRED)
if(TARGET ds4_dense AND TARGET ds4_moe_cuda)
  add_executable(ds4_serve ${CMAKE_CURRENT_SOURCE_DIR}/tools/ds4/ds4_serve.cpp)
  target_include_directories(ds4_serve PRIVATE ${_ds4_serve_inc})
  target_link_libraries(ds4_serve PRIVATE ds4_dense ds4_moe_cuda ggml ggml-base Threads::Threads)
  if(TARGET ggml-cuda)
    target_link_libraries(ds4_serve PRIVATE ggml-cuda)
  endif()
elseif(TARGET ds4_dense AND TARGET ds4_moe_cpu)
  add_executable(ds4_serve_cpu ${CMAKE_CURRENT_SOURCE_DIR}/tools/ds4/ds4_serve.cpp)
  target_include_directories(ds4_serve_cpu PRIVATE ${_ds4_serve_inc})
  target_link_libraries(ds4_serve_cpu PRIVATE ds4_dense ds4_moe_cpu ggml ggml-cpu ggml-base Threads::Threads)
endif()
add_executable(test_ds4_sampler ${CMAKE_CURRENT_SOURCE_DIR}/tools/ds4/test_ds4_sampler.cpp)
target_include_directories(test_ds4_sampler PRIVATE ${_ds4_serve_inc})
if(STRATA_BUILD_TESTS)
  add_test(NAME test_ds4_sampler COMMAND test_ds4_sampler)
endif()
